# Session Secret (generate a random string for production)
SESSION_SECRET=your-secure-random-secret-key-here

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# Email Configuration (Optional - for notifications)
# If not configured, email notifications will be disabled but the app will work
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@researchproject.com

# Node Environment
NODE_ENV=production
