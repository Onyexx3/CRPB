# .cpanelignore - Files and directories to exclude from cPanel deployment

# Development files
.git
.gitignore
.replit
.local

# Source files (not needed after build)
client/
server/
tsconfig.json
vite.config.ts
tailwind.config.ts
postcss.config.js

# Documentation
README.md
CHANGELOG.md
CLEAN_REPOSITORY_SETUP.md
design_guidelines.md

# Node modules (NEVER upload - always install on server)
# Uploading from Windows will cause "invalid ELF header" errors for native modules
node_modules/

# Development dependencies
.vscode/
.idea/
*.log

# Build cache
.cache/
.temp/
