# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
# These lines are auto-generated by cPanel when setting up Node.js App
# Update the paths below to match your actual cPanel username and domain
PassengerAppRoot "/home/YOUR_USERNAME/YOUR_DOMAIN_FOLDER"
PassengerBaseURI "/"
PassengerNodejs "/home/YOUR_USERNAME/nodevenv/YOUR_DOMAIN_FOLDER/20/bin/node"
PassengerAppType node
PassengerStartupFile app.cjs
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Prevent directory listing
Options -Indexes

# Rewrite rules for single-page application routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow static assets to pass through without rewriting
    RewriteRule ^assets/ - [L]
    RewriteRule ^favicon\.png$ - [L]
    RewriteRule ^robots\.txt$ - [L]
    RewriteRule ^sitemap\.xml$ - [L]
    RewriteRule ^.*\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp|map)$ - [L]

    # Do not rewrite existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Let React Router handle all other routes (fallback to index.html)
    RewriteRule ^ index.html [L]
</IfModule>

# Compress static assets for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Set cache headers for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security: Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|sqlite|db|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security: Prevent access to server files
<FilesMatch "^(app\.cjs|package\.json|package-lock\.json)$">
    Order allow,deny
    Deny from all
    # Allow Passenger to access app.cjs internally
    Allow from env=REDIRECT_STATUS
</FilesMatch>
